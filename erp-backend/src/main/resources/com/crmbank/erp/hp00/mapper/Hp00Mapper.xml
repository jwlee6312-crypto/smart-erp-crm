<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crmbank.erp.hp00.mapper.Hp00Mapper">

    <select id="HP00_000S_STR" parameterType="map" resultType="map">
        SELECT codecd as code, codenm, remark as etcval
        FROM haba900t_tbl
        WHERE useyn = 'Y'
        <if test="gbncd != null and gbncd != ''">
            AND cdtype = #{gbncd}
        </if>
        <if test="code != null and code != ''">
            AND codecd = #{code}
        </if>
        ORDER BY dspord
    </select>

</mapper>
