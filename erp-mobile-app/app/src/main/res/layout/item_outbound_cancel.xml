<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_input_field"
    android:layout_marginBottom="4dp">

    <!-- 선택 체크박스 -->
    <CheckBox
        android:id="@+id/cbSelect"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:buttonTint="#2196F3" />

    <!-- 1. 출고일 (ioymd) - Weight 1.0 -->
    <TextView
        android:id="@+id/tvIoYmd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:textSize="10sp"
        android:gravity="center"
        android:textColor="#333333" />

    <!-- 2. 거래처명 (custnm) - Weight 1.3 -->
    <TextView
        android:id="@+id/tvCustNm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:textSize="10sp"
        android:textColor="#333333"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 3. 창고 (whcd) - Weight 0.8 -->
    <TextView
        android:id="@+id/tvWhNm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:textSize="10sp"
        android:textColor="#333333"
        android:gravity="center" />

    <!-- 4. 출고번호 (iono) - Weight 1.2 -->
    <TextView
        android:id="@+id/tvIoNo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:textSize="10sp"
        android:textColor="#2196F3"
        android:gravity="center" />

    <!-- 5. 금액 (totamt/sumamt) - Weight 1.1 -->
    <TextView
        android:id="@+id/tvSumAmt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:textSize="10sp"
        android:textColor="#F44336"
        android:textStyle="bold"
        android:gravity="end" />

</LinearLayout>
