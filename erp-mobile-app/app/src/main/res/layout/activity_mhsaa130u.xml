<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5"
    android:importantForAutofill="noExcludeDescendants">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="상담일지 등록"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReset"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_gradient_gray"
            android:text="신규"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_gradient"
            android:text="저장"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDelete"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_gradient_orange"
            android:text="삭제"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Row 1: Sales Search -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="영업건 *"
                android:textSize="11sp"
                android:textColor="#0d6efd"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <EditText
                    android:id="@+id/etSalesTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:focusable="false"
                    android:hint="영업건 선택"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:textColor="#333333"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSalesSearch"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_button_gradient_gray"
                    android:text="조회"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Row 2: Date & Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="상담일시 *"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvContDt"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:textColor="#333333"/>
                        <EditText
                            android:id="@+id/etContHH"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center"
                            android:hint="H"
                            android:inputType="number"
                            android:textSize="13sp"/>
                        <EditText
                            android:id="@+id/etContMM"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center"
                            android:hint="M"
                            android:inputType="number"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="상담고객 *"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <Spinner
                        android:id="@+id/spKeyman"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3: Channel | Confirmation Request -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="상담채널"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <Spinner
                        android:id="@+id/spChannel"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp"
                    android:gravity="bottom">
                    <CheckBox
                        android:id="@+id/cbReportYn"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="관리자 확인요청"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#dc3545"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 4: Report Content (Optional) -->
            <TextView
                android:id="@+id/tvReportContentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보고내용 (확인요청 시)"
                android:textSize="11sp"
                android:textColor="#666666"
                android:visibility="gone"/>
            <EditText
                android:id="@+id/etReportContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="1"
                android:maxLines="5"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:padding="10dp"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"
                android:inputType="textMultiLine"
                android:hint="관리자에게 보고할 요지를 입력하세요."
                android:visibility="gone"/>

            <!-- Diary Content Area (Expanded & Smaller Font) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="상담본문 *"
                android:textSize="11sp"
                android:textColor="#666666"/>
            <EditText
                android:id="@+id/etDiaryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="12"
                android:maxLines="30"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:padding="10dp"
                android:textSize="11sp"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"
                android:inputType="textMultiLine"
                android:lineSpacingExtra="4dp"/>

            <!-- Coaching Result Area (Shown when coaching exists) -->
            <LinearLayout
                android:id="@+id/layoutCoachingResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E8F5E9"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvCoachingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="상담코칭 (관리자 지시사항)"
                    android:textSize="11sp"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvSalesCoaching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"/>
                <TextView
                    android:id="@+id/tvCoachingDt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#666666"
                    android:gravity="end"
                    android:layout_marginTop="8dp"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnConfirmCoaching"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_gradient"
                    android:text="지시사항 확인"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- History List Area -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="해당 영업건 상담 이력"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="#E0E0E0"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="일자" android:gravity="center" android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:text="내용 요약" android:gravity="center" android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="상태" android:gravity="center" android:textSize="10sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llDiaryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
