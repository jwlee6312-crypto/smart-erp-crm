<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5"
    android:importantForAutofill="noExcludeDescendants">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Key맨 등록"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReset"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_gradient_gray"
            android:text="신규"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_gradient"
            android:text="저장"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDelete"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_gradient_orange"
            android:text="삭제"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Sales Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="영업건 *"
                android:textSize="11sp"
                android:textColor="#0d6efd"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <EditText
                    android:id="@+id/etSalesTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:focusable="false"
                    android:hint="영업건 선택"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSalesSearch"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_button_gradient_gray"
                    android:text="조회"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Name | Dept/Rank -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="성명 *"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="10dp"
                        android:textSize="13sp"
                        android:textColor="#333333"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="부서/직위"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/etDept"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="8dp"
                            android:textSize="13sp"
                            android:textColor="#333333"/>
                        <EditText
                            android:id="@+id/etJikch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.8"
                            android:layout_marginStart="2dp"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="8dp"
                            android:textSize="13sp"
                            android:textColor="#333333"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- HP | Tel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="휴대폰 *"
                        android:textSize="11sp"
                        android:textColor="#dc3545"
                        android:textStyle="bold"/>
                    <EditText
                        android:id="@+id/etHpNo"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="phone"
                        android:paddingHorizontal="10dp"
                        android:textSize="13sp"
                        android:textColor="#333333"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="직통전화"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <EditText
                        android:id="@+id/etTelNo"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="phone"
                        android:paddingHorizontal="10dp"
                        android:textSize="13sp"
                        android:textColor="#333333"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이메일"
                android:textSize="11sp"
                android:textColor="#666666"/>
            <EditText
                android:id="@+id/etMail"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_input_field"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="10dp"
                android:textSize="13sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <!-- Birthday | GB | Favor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:layout_marginEnd="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="생일"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvBirthday"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:textColor="#333333"/>
                        <Spinner
                            android:id="@+id/spBirGb"
                            android:layout_width="60dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:background="@drawable/bg_input_field"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="호감도"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <Spinner
                        android:id="@+id/spFavor"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="관리등급"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <Spinner
                        android:id="@+id/spLevel"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Remark (Expandable) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="특이사항"
                android:textSize="11sp"
                android:textColor="#666666"/>
            <EditText
                android:id="@+id/etRemark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="1"
                android:maxLines="10"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:padding="10dp"
                android:textSize="13sp"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"
                android:inputType="textMultiLine"/>

            <!-- List Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="해당 거래처 Key맨 리스트"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="#E0E0E0"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="성명" android:gravity="center" android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="부서" android:gravity="center" android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="휴대폰" android:gravity="center" android:textSize="10sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llKeymanList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
