<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvCustNm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="거래처명"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#333333"/>
            <TextView
                android:id="@+id/tvState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="진행중"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvSalesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="영업건명"
            android:textSize="12sp"
            android:textColor="#0d6efd"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/tvUserNm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="담당자"
                android:textSize="11sp"
                android:textColor="#666666"/>
            <View
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:background="#DDDDDD"
                android:layout_marginHorizontal="8dp"
                android:layout_gravity="center_vertical"/>
            <TextView
                android:id="@+id/tvAddTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025-03-14"
                android:textSize="11sp"
                android:textColor="#666666"/>
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/tvForeAmt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10,000,000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
