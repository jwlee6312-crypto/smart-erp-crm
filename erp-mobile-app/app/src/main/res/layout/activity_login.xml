<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/login_bg_end"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp"> <!-- Padding reduced -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"> <!-- Padding reduced -->

                <!-- Logo Section (ic_main_logo 적용) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/ivMainLogo"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_main_logo"
                        android:contentDescription="SmartERP Main Logo" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Smart"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/smart_blue"
                            android:letterSpacing="-0.02"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Core"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/core_amber"
                            android:letterSpacing="-0.02"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI POWERED"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/smart_blue"
                        android:background="@color/ai_badge_bg"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Integrated Business Solution"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_title"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intelligence-Driven ERP &amp; CRM Integration"
                    android:textSize="11sp"
                    android:textColor="@color/text_subtitle"
                    android:layout_gravity="center"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"/>

                <!-- Form Fields (Standardized height) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Company Code"
                    android:textColor="@color/form_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etCompanyCode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Company Code"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_title"
                    android:textColorHint="#A0AEC0"
                    android:textSize="13sp"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="User ID"
                    android:textColor="@color/form_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etId"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="User ID"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_title"
                    android:textColorHint="#A0AEC0"
                    android:textSize="13sp"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="@color/form_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Password"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_title"
                    android:textColorHint="#A0AEC0"
                    android:textSize="13sp"
                    android:inputType="textPassword"
                    android:importantForAutofill="no"
                    android:layout_marginBottom="24dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_button_gradient"
                    android:text="Log In"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"
                    android:elevation="2dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="© 2024 SmartCore"
                    android:textSize="10sp"
                    android:textColor="#A0AEC0"
                    android:gravity="center"
                    android:layout_marginTop="24dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
