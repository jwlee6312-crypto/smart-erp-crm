<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- 1. Header Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="품목 등록 (MHSBA010U)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReset"
            android:layout_width="55dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_gradient_gray"
            android:text="신규"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSearch"
            android:layout_width="55dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_gradient_gray"
            android:text="조회"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="55dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_gradient"
            android:text="저장"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 2. Search Filter Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:layout_margin="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="재고자산"
            android:textSize="11sp"
            android:textColor="#333333"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spSearchAstKind"
            android:layout_width="110dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginEnd="6dp"/>

        <EditText
            android:id="@+id/etSearchItemNm"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="품목명 또는 코드"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- 3. Form Input Card (Scrollable) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Detail Form Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="8dp">

                <!-- Row 1: 재고자산 & 품목코드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="재고자산"
                        android:textSize="11sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <Spinner
                        android:id="@+id/spAstKind"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1.2"
                        android:background="@drawable/bg_input_field"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:text="품목코드"
                        android:textSize="11sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etItemCd"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="자동/입력"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="#005A9F"
                        android:textStyle="bold"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Row 2: 품목명 & 규격 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="품목명 *"
                        android:textSize="11sp"
                        android:textColor="#005A9F"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etItemNm"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1.5"
                        android:background="@drawable/bg_input_field"
                        android:hint="품목명 입력"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="규격"
                        android:textSize="11sp"
                        android:textColor="#333333"/>

                    <EditText
                        android:id="@+id/etItSize"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="규격"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Row 3: 단위 & 매입단가 & 매출단가 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="단위"
                        android:textSize="11sp"
                        android:textColor="#333333"/>

                    <Spinner
                        android:id="@+id/spUnit"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:text="매입단가"
                        android:textSize="11sp"
                        android:textColor="#333333"/>

                    <EditText
                        android:id="@+id/etImPrice"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:inputType="numberDecimal"
                        android:gravity="end"
                        android:paddingEnd="8dp"
                        android:text="0"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:text="매출단가"
                        android:textSize="11sp"
                        android:textColor="#333333"/>

                    <EditText
                        android:id="@+id/etOmPrice"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:inputType="numberDecimal"
                        android:gravity="end"
                        android:paddingEnd="8dp"
                        android:text="0"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Row 4: 바코드 & 비고 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="바코드"
                        android:textSize="11sp"
                        android:textColor="#333333"/>

                    <EditText
                        android:id="@+id/etBarcode"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="바코드"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="비고"
                        android:textSize="11sp"
                        android:textColor="#333333"/>

                    <EditText
                        android:id="@+id/etRemark"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1.5"
                        android:background="@drawable/bg_input_field"
                        android:hint="특기사항"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- List Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:orientation="vertical"
                android:background="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:background="#E0E0E0"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:text="품목코드" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.6" android:text="품목명" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:text="규격" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:text="단위" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:text="매출단가" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#005A9F"/>
                </LinearLayout>

                <ListView
                    android:id="@+id/lvItemList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="#F0F2F5"
                    android:dividerHeight="1dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
