<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="6dp">

    <!-- Row 1: 선택 체크박스 & 구분 & 관리번호 & 거래처 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tvGubun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="주문건"
            android:textSize="10sp"
            android:textColor="#005A9F"
            android:background="#E3F2FD"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvShowSord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="202610-0001"
            android:textSize="11sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvCustNm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="거래처명"
            android:textSize="11sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Row 2: 제품명 & 규격 & 요청수량 & 납기일 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="제품명"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="#005A9F"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvItSize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="규격"
            android:textSize="11sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvOrdQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="요청: 0"
            android:textSize="11sp"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvNapgiYmd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="납기: -"
            android:textSize="10sp"
            android:textColor="#333333"/>
    </LinearLayout>

</LinearLayout>
