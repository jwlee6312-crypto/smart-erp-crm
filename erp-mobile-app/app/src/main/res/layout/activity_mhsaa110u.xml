<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5"
    android:importantForAutofill="noExcludeDescendants">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="영업건 등록"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReset"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_gradient_gray"
            android:text="신규"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_gradient"
            android:text="저장"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDelete"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_gradient_orange"
            android:text="삭제"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Row 1: Sales ID & Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="영업ID"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <EditText
                            android:id="@+id/etSalesId"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:hint="(자동 생성)"
                            android:paddingHorizontal="10dp"
                            android:textSize="13sp"
                            android:textColor="#333333"
                            android:focusable="false"/>
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnSalesSearch"
                            android:layout_width="45dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_button_gradient_gray"
                            android:text="조회"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="등록일자 *"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <TextView
                        android:id="@+id/tvAddTime"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="#333333"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Customer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="거래처명 *"
                android:textSize="11sp"
                android:textColor="#0d6efd"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etCustNm"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_input_field"
                android:focusable="false"
                android:hint="거래처 선택"
                android:paddingHorizontal="10dp"
                android:textSize="13sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- Row 3: Boss & Tel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="대표자"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <EditText
                        android:id="@+id/etBossNm"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"
                        android:enabled="false"
                        android:paddingHorizontal="10dp"
                        android:textSize="13sp"
                        android:textColor="#333333"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="전화번호"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <EditText
                        android:id="@+id/etTelNo"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"
                        android:enabled="false"
                        android:paddingHorizontal="10dp"
                        android:textSize="13sp"
                        android:textColor="#333333"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 4: Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="영업건명 *"
                android:textSize="11sp"
                android:textColor="#0d6efd"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etSalesTitle"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_input_field"
                android:hint="영업건명 입력"
                android:paddingHorizontal="10dp"
                android:textSize="13sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <!-- Row 5: User | State | Rank (Optimized Row) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:layout_marginEnd="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="영업담당 *"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <Spinner
                        android:id="@+id/spUser"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="진행상태 *"
                        android:textSize="11sp"
                        android:textColor="#dc3545"
                        android:textStyle="bold"/>
                    <Spinner
                        android:id="@+id/spState"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical"
                    android:layout_marginStart="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="중요도 *"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <Spinner
                        android:id="@+id/spImportRank"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 6: ForeAmt | ForeDt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="예상수주액 *"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <EditText
                        android:id="@+id/etForeAmt"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="end"
                        android:paddingHorizontal="10dp"
                        android:textSize="13sp"
                        android:textColor="#333333"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="예상수주일 *"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <TextView
                        android:id="@+id/tvForeDt"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="#333333"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 7: SuccRate | RtnCd | Choice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical"
                    android:layout_marginEnd="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="확도(%)"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <EditText
                        android:id="@+id/etSuccRate"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:textSize="13sp"
                        android:textColor="#333333"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="유치경로"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <Spinner
                        android:id="@+id/spRtnCd"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:orientation="vertical"
                    android:layout_marginStart="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="선정방법"
                        android:textSize="11sp"
                        android:textColor="#666666"/>
                    <Spinner
                        android:id="@+id/spChoice"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_input_field"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 8: Remark (Expandable) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="상세내용"
                android:textSize="11sp"
                android:textColor="#666666"/>
            <EditText
                android:id="@+id/etSalesRemark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="1"
                android:maxLines="10"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:padding="10dp"
                android:textSize="13sp"
                android:textColor="#333333"
                android:layout_marginBottom="12dp"
                android:inputType="textMultiLine"/>

            <!-- List Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="관련 품목 리스트"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddItem"
                    android:layout_width="80dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_button_gradient_gray"
                    android:text="+ 품목추가"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Item List Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="#E0E0E0"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:text="품명" android:gravity="center" android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.5" android:text="수량" android:gravity="center" android:textSize="10sp" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:text="금액" android:gravity="center" android:textSize="10sp" android:textStyle="bold"/>
                    <View android:layout_width="34dp" android:layout_height="0dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llItemList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
