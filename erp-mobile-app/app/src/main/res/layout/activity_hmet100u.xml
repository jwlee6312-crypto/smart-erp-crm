<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:importantForAutofill="noExcludeDescendants">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="회의록 조회 (HMET100U)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSearch"
                android:layout_width="65dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_gradient"
                android:text="조회"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Form Container (View Only) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_margin="8dp"
            android:elevation="2dp">

            <!-- 회의일자 / 시간 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="회의일자"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvMeetingDt"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:text="2026-10-23"
                    android:textSize="12sp"
                    android:textColor="#333333"/>

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text=" 시간"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:gravity="end"/>

                <EditText
                    android:id="@+id/etMeetingTime"
                    android:layout_width="70dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_input_field"
                    android:focusable="false"
                    android:enabled="false"
                    android:paddingStart="8dp"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- 장소 / 주관자 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="회의장소"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etLocation"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:focusable="false"
                    android:enabled="false"
                    android:paddingStart="8dp"
                    android:textSize="12sp"/>

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text=" 주관"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:gravity="end"/>

                <EditText
                    android:id="@+id/etHostNm"
                    android:layout_width="90dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_input_field"
                    android:focusable="false"
                    android:enabled="false"
                    android:paddingStart="8dp"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- 회의제목 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="회의제목"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etMeetingTit"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:focusable="false"
                    android:enabled="false"
                    android:paddingStart="8dp"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- 녹취 파일 첨부 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="녹취첨부"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvAudioFile"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:text="첨부된 녹취 파일 없음"
                    android:paddingStart="8dp"
                    android:textSize="12sp"
                    android:textColor="#666666"/>
            </LinearLayout>

            <!-- STT 원본 텍스트 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[녹취 STT 텍스트 원본]"
                android:textSize="11sp"
                android:textColor="#666666"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp"/>

            <EditText
                android:id="@+id/etSttText"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:focusable="false"
                android:enabled="false"
                android:padding="8dp"
                android:textSize="11sp"
                android:layout_marginBottom="8dp"/>

            <!-- 회의요약 (AI) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[AI 회의 요약]"
                android:textSize="11sp"
                android:textColor="#1976D2"
                android:textStyle="bold"
                android:layout_marginBottom="2dp"/>

            <EditText
                android:id="@+id/etSummary"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:focusable="false"
                android:enabled="false"
                android:padding="8dp"
                android:textSize="11sp"
                android:layout_marginBottom="8dp"/>

            <!-- 회의 상세 내용 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[회의 상세 내용]"
                android:textSize="11sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:layout_marginBottom="2dp"/>

            <EditText
                android:id="@+id/etContent"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:focusable="false"
                android:enabled="false"
                android:padding="8dp"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
