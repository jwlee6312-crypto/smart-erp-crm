<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5"
    android:importantForAutofill="noExcludeDescendants">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="견적서 등록 (MHSQT_100U)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNew"
            android:layout_width="55dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_gradient_gray"
            android:text="신규"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="65dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_gradient_orange"
            android:text="저장"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Master Form -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:layout_margin="8dp"
        android:elevation="2dp">

        <!-- Row 1: 견적년월 / 견적번호 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="견적년월/번호"
                android:textSize="11sp"
                android:textColor="#333333"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etQuatYm"
                android:layout_width="80dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_input_field"
                android:hint="YYYYMM"
                android:paddingStart="8dp"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etQuatNo"
                android:layout_width="60dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="번호"
                android:paddingStart="8dp"
                android:textSize="12sp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSearch"
                android:layout_width="55dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_gradient_gray"
                android:text="조회"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Row 2: 거래처명 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="거 래 처"
                android:textSize="11sp"
                android:textColor="#333333"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etCustName"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="거래처명 입력"
                android:paddingStart="10dp"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Row 3: 견적일자 / 유효기간 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="견적/유효일"
                android:textSize="11sp"
                android:textColor="#333333"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvQuatYmd"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:text="2026-10-23"
                android:textSize="12sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tvValidDate"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:text="2026-11-23"
                android:textSize="12sp"
                android:textColor="#333333"/>
        </LinearLayout>

        <!-- Row 4: 비고 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="비 고"
                android:textSize="11sp"
                android:textColor="#333333"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etRemark"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="비고 입력"
                android:paddingStart="10dp"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Detail List Header & Add Row Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="견적 품목 상세 내역"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textSize="14sp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAddRow"
            android:layout_width="65dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_gradient_gray"
            android:text="행추가"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Detail ListView -->
    <ListView
        android:id="@+id/lvDetailList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:paddingHorizontal="8dp"/>

</LinearLayout>
