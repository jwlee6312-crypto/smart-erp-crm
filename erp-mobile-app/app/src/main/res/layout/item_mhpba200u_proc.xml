<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="6dp">

    <!-- Row 1: 공정코드 & 공정명 & 순서 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvProgCd"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:text="PROG01"
            android:textSize="11sp"
            android:textColor="#005A9F"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvProgNm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="공정명"
            android:textSize="12sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="6dp"/>

        <TextView
            android:id="@+id/tvDspOrd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="순서: 1"
            android:textSize="10sp"
            android:textColor="#666666"
            android:background="#E2E8F0"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"/>
    </LinearLayout>

    <!-- Row 2: 가동율 & 양품율 & 소요시간 & 일가동시간 & 일생산량 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRates"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="가동 100% / 양품 100%"
            android:textSize="11sp"
            android:textColor="#666666"/>

        <TextView
            android:id="@+id/tvTimes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="소요: 1.0분 / 일가동: 8h"
            android:textSize="11sp"
            android:textColor="#333333"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvPQtyDd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="일생산: 480"
            android:textSize="11sp"
            android:textColor="#005A9F"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
