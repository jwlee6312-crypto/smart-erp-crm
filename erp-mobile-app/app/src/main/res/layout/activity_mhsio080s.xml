<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="발주 현황"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSearch"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_gradient"
            android:text="조회"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 발주기간 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="발주기간"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvDateFrom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="2024-01-01"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvDateTo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="2024-01-31"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 발주부서 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="발주부서"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"/>
            <TextView
                android:id="@+id/tvDeptNm"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="부서 선택"
                android:textSize="13sp"
                android:textColor="#333333"/>
        </LinearLayout>

        <!-- 거래처명 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="거래처명"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"/>
            <EditText
                android:id="@+id/etCustNm"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:hint="거래처명 입력"
                android:paddingStart="12dp"
                android:textSize="13sp"
                android:textColor="#333333"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 리스트 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:background="#E0E0E0"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="거래처" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.8" android:text="품명" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="수량" android:gravity="end" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="합계금액" android:gravity="end" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
    </LinearLayout>

    <ListView
        android:id="@+id/lvOrderStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#F0F2F5"
        android:dividerHeight="1dp"
        android:background="#FFFFFF"/>

    <!-- 하단 합계 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="#333333"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0건"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="총 합계:"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:alpha="0.8"/>
        <TextView
            android:id="@+id/tvTotalAmt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0"
            android:textColor="#FFC107"
            android:textStyle="bold"
            android:textSize="16sp"/>
    </LinearLayout>

</LinearLayout>
