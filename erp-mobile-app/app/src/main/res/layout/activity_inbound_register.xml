<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5"
    android:importantForAutofill="noExcludeDescendants">

    <!-- 1. Header Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="바코드 입고 처리"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReset"
            android:layout_width="55dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_gradient_gray"
            android:text="신규"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="65dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_gradient"
            android:text="스캔완료"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 2. Master Input Form -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:layout_margin="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="입고의뢰"
                android:textSize="11sp"
                android:textColor="#333333"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etInboundNo"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="바코드 스캔 자동입력"
                android:paddingStart="10dp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSearchOrder"
                android:layout_width="45dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_gradient_gray"
                android:text="조회"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/btnScan"
                android:layout_width="45dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_gradient"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="바코드스캔" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="입고일자"
                android:textSize="11sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tvInboundDate"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="입고창고"
                android:textSize="11sp"
                android:textColor="#333333"/>

            <Spinner
                android:id="@+id/spWarehouse"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"/>
        </LinearLayout>

        <!-- Row 3: 거래처명 (독립 전용 줄) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="거래처명"
                android:textSize="11sp"
                android:textColor="#333333"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etCustomerName"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:paddingStart="10dp"
                android:textSize="12sp"
                android:hint="거래처명 자동채움"
                android:focusable="false"
                android:textColor="#333333"/>
        </LinearLayout>

        <!-- Row 4: 특기사항 (독립 전용 줄) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="특기사항"
                android:textSize="11sp"
                android:textColor="#333333"/>

            <EditText
                android:id="@+id/etRemark"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:paddingStart="10dp"
                android:textSize="12sp"
                android:hint="비고 내용"/>

            <EditText
                android:id="@+id/etOrderNo"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Detail Scan Item List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:layout_margin="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="#E0E0E0"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:text="품목코드" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:text="품명" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="LOT/시리얼" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#E65100"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.7" android:text="의뢰수량" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.7" android:text="스캔수량" android:gravity="center" android:textSize="11sp" android:textStyle="bold" android:textColor="#005A9F"/>
        </LinearLayout>

        <ListView
            android:id="@+id/lvRegisterList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#F0F2F5"
            android:dividerHeight="1dp"/>
    </LinearLayout>
</LinearLayout>
