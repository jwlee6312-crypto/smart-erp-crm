<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="거래명세표"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPreview"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_gradient_gray"
            android:text="미리보기"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSearch"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_gradient"
            android:text="조회"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 검색 조건 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="출고일자"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvDateFrom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="2024-01-01"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvDateTo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="2024-01-31"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="거래처"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"/>
            <EditText
                android:id="@+id/etCustNm"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:hint="여기를 눌러 거래처 선택"
                android:paddingStart="12dp"
                android:textSize="13sp"
                android:focusable="false"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 메인 작업 영역: 출고 목록 (카드 형태) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="출고 목록"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="4dp"/>

    <ListView
        android:id="@+id/lvMasterList"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:divider="#F0F2F5"
        android:dividerHeight="1dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <!-- 상세 품목 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:background="#E0E0E0"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="품명/규격" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="수량" android:gravity="end" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="금액" android:gravity="end" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333"/>
    </LinearLayout>

    <ListView
        android:id="@+id/lvDetailList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#F0F2F5"
        android:dividerHeight="1dp"
        android:background="#FFFFFF"/>

</LinearLayout>
