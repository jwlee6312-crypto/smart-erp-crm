<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F5">

    <!-- 1. Header Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="품목별 표준공정도 (MHPBA200U)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReset"
            android:layout_width="55dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_button_gradient_gray"
            android:text="초기화"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSearch"
            android:layout_width="55dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_gradient"
            android:text="조회"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 2. Search Filter Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:layout_margin="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="생산라인"
            android:textSize="11sp"
            android:textColor="#333333"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spLine"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="재고자산"
            android:textSize="11sp"
            android:textColor="#333333"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spAstKind"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"/>
    </LinearLayout>

    <!-- 3. Dual List Panel (Items & Processes) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="8dp">

        <!-- Upper: Target Item List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="#E2E8F0"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="대상 품목 리스트"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#005A9F"/>
            </LinearLayout>

            <ListView
                android:id="@+id/lvItemList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#F0F2F5"
                android:dividerHeight="1dp"/>
        </LinearLayout>

        <!-- Lower: Standard Process List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="#E2E8F0"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="표준 공정 설정"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#005A9F"/>

                <TextView
                    android:id="@+id/tvSelectedItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="품목을 선택하세요"
                    android:textSize="11sp"
                    android:textColor="#E65100"
                    android:textStyle="bold"/>
            </LinearLayout>

            <ListView
                android:id="@+id/lvProcList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#F0F2F5"
                android:dividerHeight="1dp"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
