<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="6dp">

    <!-- Row 1: 선택 체크박스 & 상태 배지 & 생산일자 & 공정명 & 의뢰번호 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="의뢰대기"
            android:textSize="10sp"
            android:textColor="#005A9F"
            android:background="#E3F2FD"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvProYmd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-10-10"
            android:textSize="11sp"
            android:textColor="#333333"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvProgNm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="조립공정"
            android:textSize="11sp"
            android:textColor="#666666"/>

        <TextView
            android:id="@+id/tvInspReqNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REQ-0001"
            android:textSize="10sp"
            android:textColor="#E65100"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Row 2: 제품명 & 규격/단위 & 생산량 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="제품명"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="#005A9F"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvItSize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="규격 / EA"
            android:textSize="11sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvPrdQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="생산량: 0"
            android:textSize="11sp"
            android:textColor="#2E7D32"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
